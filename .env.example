# API Keys Configuration
# Copy this file to .env and fill in your API keys

# iNaturalist API (Free, no key required for basic queries)
INATURALIST_APP_ID=cropshield
INATURALIST_APP_SECRET=

# Flickr API (Free - Get keys from: https://www.flickr.com/services/api/misc.api_keys.html)
FLICKR_API_KEY=your_flickr_api_key_here
FLICKR_API_SECRET=your_flickr_api_secret_here

# Kaggle API (for automated download)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Data Collection Settings
MAX_IMAGES_PER_CLASS=2500
INATURALIST_MAX_IMAGES=3000
FLICKR_MAX_IMAGES=2500

# Quality Filtering Thresholds
BLUR_THRESHOLD=100
EXPOSURE_LOW_THRESHOLD=0.20
EXPOSURE_HIGH_THRESHOLD=0.80
DUPLICATE_SIMILARITY_THRESHOLD=0.95
OUTLIER_STD_THRESHOLD=3.0
